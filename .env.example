# Attractor secrets — copy to `.env` (gitignored, NEVER committed).
# Read via attractor-config::secret(&env, "KEY"), which checks this file first,
# then the process environment, then fails LOUD (no silent default).
#
# Anything sensitive (tokens, passwords, keys) belongs here or in the real
# process env — never in config.yaml and never in a tracked .rs/.ps1 file.

# Example: control-plane auth token for attractor-api.
ATTRACTOR_API_TOKEN=replace-me

# Example: embedding-service key, if ingest calls out.
# ATTRACTOR_EMBED_KEY=replace-me
