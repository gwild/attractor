# attractor.service — Attractor daemon on Homer (user unit, #2288 deploy).
#
# Install (after building the image, see docker/README.md):
#   mkdir -p ~/attractor-run ~/.config/systemd/user
#   cp docker/attractor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now attractor
#
# Local agents connect via ATTRACTOR_SOCKET_PATH=%h/attractor-run/attractor_api.sock
# (atctl picks it up from the environment). No TCP listener: the daemon is
# unix-socket-only by default — enabling remote access is a deliberate edit
# (add `--tcp 127.0.0.1:7533` plus a reviewed exposure plan), never a default.
#
# The daemon snapshots store state to /run/attractor/store.json inside the
# container. Because /run/attractor is bind-mounted from %h/attractor-run below,
# docker restart reloads the prior matrix before accepting requests.
#
# Why no Requires=docker.service: this is a USER unit; the user manager cannot
# see system units, so a Requires/After on docker.service would be silently
# ignored — exactly the kind of fail-soft RULES.md forbids. Instead the first
# ExecStartPre fails loud when the docker daemon is unreachable, and
# Restart/RestartSec retries cover the daemon-still-booting window.

[Unit]
Description=Attractor matrix daemon (docker)

[Service]
# Fail loud if the docker daemon is unreachable (replaces the unusable
# system-unit dependency above).
ExecStartPre=/usr/bin/docker version
# Rebuild the runtime image if a docker prune removed it, so an image cleanup
# can never leave the bare-name `docker run` below falling back to a Docker Hub
# pull that crash-loops (homer, 2026-09-23). Instant no-op when the image is
# present; the slow rebuild path runs only after a prune — TimeoutStartSec
# below covers a from-scratch release build.
ExecStartPre=/bin/bash -c '/usr/bin/docker image inspect attractor-run:latest >/dev/null 2>&1 || /usr/bin/docker build -f %h/attractor/docker/Dockerfile.run -t attractor-run:latest %h/attractor'
# Remove a stale container from an unclean stop. `docker inspect` exits 1
# for BOTH container-absent and real errors (daemon, permissions), so only
# stderr distinguishes them: the not-found case is matched explicitly and
# is the ONLY quiet path; any other inspect failure is surfaced and fails
# the start, as does a failed removal of an existing container.
ExecStartPre=/bin/bash -c 'err=$(/usr/bin/docker container inspect attractor 2>&1 >/dev/null); rc=$?; \
  if [ "$rc" -eq 0 ]; then exec /usr/bin/docker rm -f attractor; fi; \
  case "$err" in *"No such container"*) exit 0;; \
  *) printf "%%s\n" "$err" >&2; exit "$rc";; esac'
ExecStart=/usr/bin/docker run --name attractor --rm --init \
    --user 1000:1000 \
    -v %h/attractor-run:/run/attractor \
    attractor-run:latest
ExecStop=/usr/bin/docker stop attractor
Restart=on-failure
RestartSec=5
# A from-scratch Rust release build (post-prune recovery in the build-if-missing
# ExecStartPre above) far exceeds the 90s default; allow it to finish.
TimeoutStartSec=3600

[Install]
WantedBy=default.target
